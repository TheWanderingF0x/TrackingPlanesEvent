# Placeholders only — copy to `.env` and fill with YOUR OpenSky OAuth client.
# Never commit a real `.env`. See SECURITY.md.

# OpenSky OAuth2 credentials (required) — create an API client at:
# https://opensky-network.org/my-opensky (Account page)
OPENSKY_CLIENT_ID=your_client_id_here
OPENSKY_CLIENT_SECRET=your_client_secret_here

# Collector
POLL_INTERVAL_SECONDS=120
DATA_DIR=data
AIRLINES_CONFIG=config/airlines_europe.yaml

# PySpark flight sessionization
MAX_GAP_SECONDS=1800
# Driver heap for local[*] Spark (use 4g on Oracle A1 12 GB VMs)
SPARK_DRIVER_MEMORY=2g

# Optional — Streamlit route map (Google Maps JavaScript API)
# https://console.cloud.google.com/apis/library/maps-backend.googleapis.com
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional — Databricks Volume sync (Phase 1).
# Host = workspace URL from browser (no trailing slash).
# Token = User Settings → Developer → Access tokens (keep .env out of git).
DATABRICKS_HOST=https://YOUR_WORKSPACE.cloud.databricks.com
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=trackingplanes
DATABRICKS_SCHEMA=trackingplanes
DATABRICKS_VOLUME=tracking_planes

# Optional — adsb.lol gap-fill for UNKNOWN types (does NOT replace OpenSky).
# Prefer collector raw → pair_raw cache. Live per-hex lookups off by default (avoids 429).
# Set ADSB_MAX_LIVE_LOOKUPS=20 only if you need extra fill and are not rate-limited.
ADSB_ENRICH=1
ADSB_MAX_LIVE_LOOKUPS=0

# Callsign → scheduled OD (adsb.lol VRS + adsbdb).
# Collected raw under data/raw/callsign_routes/; paired on PC + optional Spark fill.
# Cache: data/reference/callsign_routes.parquet
CALLSIGN_OD_ENRICH=1
CALLSIGN_OD_MAX_LOOKUPS=200

# Collector: default is multi-API (OpenSky + adsb.lol + callsign OD).
# Use: python scripts/run_collector.py [--once] [--opensky-only]
